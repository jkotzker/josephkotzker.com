{
  "name": "josephkotzker.com",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "prebuild": "node -e \"require('fs').mkdirSync('.resume',{recursive:true})\"",
    "build": "astro build",
    "precheck": "node -e \"require('fs').mkdirSync('.resume',{recursive:true})\"",
    "check": "astro check",
    "preview": "astro preview",
    "test": "vitest run",
    "verify": "node scripts/verify-dist.mjs && node scripts/check-links.mjs dist",
    "ci": "npm run check && npm test && npm run build && npm run verify"
  },
  "dependencies": {
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.4",
    "astro": "^7.3.5",
    "fast-xml-parser": "^5.11.2",
    "yaml": "^2.9.1"
  },
  "allowScripts": {
    "esbuild": true
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  }
}
