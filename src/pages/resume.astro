---
import { getEntry, render } from 'astro:content';
import Base from '../layouts/Base.astro';

const entry = await getEntry('resume', 'resume');
const Content = entry?.data.public === true ? (await render(entry)).Content : null;
---
<Base title="Resume" description="Resume of Joseph Kotzker." noindex={!Content}>
  {Content ? <Content /> : <p>Resume coming soon.</p>}
</Base>
