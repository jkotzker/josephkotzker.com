---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { isoDate } from '../../lib/dates';
import { visiblePosts } from '../../lib/posts';

export async function getStaticPaths() {
  const posts = visiblePosts(await getCollection('posts'), { includeDrafts: import.meta.env.DEV });
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}

const { post } = Astro.props;
const { Content } = await render(post);
---
<Base title={post.data.title} description={post.data.description}>
  <article class="prose">
    <h1>{post.data.title}</h1>
    <p class="meta byline"><time datetime={isoDate(post.data.pubDate)}>{isoDate(post.data.pubDate)}</time></p>
    <Content />
  </article>
</Base>
