---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { visiblePosts } from '../../lib/posts';

export async function getStaticPaths() {
  const posts = visiblePosts(await getCollection('posts'), { includeDrafts: import.meta.env.DEV });
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}

const { post } = Astro.props;
const { Content } = await render(post);
---
<Base title={post.data.title} description={post.data.description}>
  <article>
    <h1>{post.data.title}</h1>
    <time datetime={post.data.pubDate.toISOString()}>{post.data.pubDate.toISOString().slice(0, 10)}</time>
    <Content />
  </article>
</Base>
