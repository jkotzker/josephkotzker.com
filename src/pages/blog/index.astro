---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { isoDate } from '../../lib/dates';
import { visiblePosts } from '../../lib/posts';

const posts = visiblePosts(await getCollection('posts'), { includeDrafts: import.meta.env.DEV });
---
<Base title="Blog" description="Writing by Joseph Kotzker.">
  <h1>Blog</h1>
  {posts.length === 0 ? (
    <p>No posts yet.</p>
  ) : (
    <ul class="labelled">
      {posts.map((post) => (
        <li>
          <time class="label" datetime={isoDate(post.data.pubDate)}>{isoDate(post.data.pubDate)}</time>
          <a href={`/blog/${post.id}/`}>{post.data.title}{post.data.draft && ' (draft)'}</a>
        </li>
      ))}
    </ul>
  )}
</Base>
