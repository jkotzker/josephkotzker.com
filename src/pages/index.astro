---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import headshot from '../assets/headshot.jpg';
import Base from '../layouts/Base.astro';
import { inAuthoredOrder } from '../lib/curated-loader';
import { isoDate } from '../lib/dates';
import { primaryLink } from '../lib/links';
import { visiblePosts } from '../lib/posts';

const HOME_POSTS = 5;
const posts = visiblePosts(await getCollection('posts'), { includeDrafts: import.meta.env.DEV }).slice(0, HOME_POSTS);
const podcasts = inAuthoredOrder(await getCollection('podcasts'));
const projects = inAuthoredOrder(await getCollection('projects'));
// "Co-host, with …" reads as a clause after the dash on this page.
const asClause = (s: string) => s.charAt(0).toLowerCase() + s.slice(1);
---
<Base title="Joseph Kotzker" description="Joseph Kotzker, senior software engineer at Fandom and co-host of In Reverse.">
  <div class="headshot"><Image src={headshot} alt="Joseph Kotzker" width={96} height={96} densities={[1, 2, 3]} loading="eager" /></div>
  <h1>Joseph Kotzker</h1>
  <p>I'm a senior software engineer currently at <a href="https://about.fandom.com">Fandom</a>; I work across the stack, but mostly on the backend systems and services powering the fan experiences Fandom is known for. With my brother Zach, I co-host <a href="https://www.inreversecast.com">In Reverse</a>, a podcast about the Fast &amp; Furious films from two people who had never seen one until we started at <em>Fast X</em> and worked our way back. I also write, build and make a few other things, most of which you'll find here.</p>

  {posts.length > 0 && (
    <>
      <h2 id="blog">Blog</h2>
      <ul class="labelled">
        {posts.map((post) => (
          <li><time class="label" datetime={isoDate(post.data.pubDate)}>{isoDate(post.data.pubDate)}</time> <a href={`/blog/${post.id}/`}>{post.data.title}</a></li>
        ))}
      </ul>
    </>
  )}

  {podcasts.length > 0 && (
    <>
      <h2 id="podcasts">Podcasts</h2>
      <ul>
        {podcasts.map(({ data }) => (
          <li><a href={primaryLink(data.links).url}>{data.name}</a> <span class="meta">— {asClause(data.role)}</span></li>
        ))}
      </ul>
    </>
  )}

  {projects.length > 0 && (
    <>
      <h2 id="projects">Projects</h2>
      <ul>
        {projects.map(({ data }) => (
          <li><a href={primaryLink(data.links).url}>{data.name}</a> <span class="meta">— {data.summary}</span></li>
        ))}
      </ul>
    </>
  )}
</Base>
