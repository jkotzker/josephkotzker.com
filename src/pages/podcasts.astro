---
import { getCollection } from 'astro:content';
import LinkRow from '../components/LinkRow.astro';
import Base from '../layouts/Base.astro';
import { inlineMarkdown } from '../lib/inline-markdown';
import { inAuthoredOrder } from '../lib/curated-loader';

const podcasts = inAuthoredOrder(await getCollection('podcasts'));
const label = (e: { season?: number; episode?: number }) =>
  e.season !== undefined && e.episode !== undefined ? `S${e.season} E${e.episode}` : '';
---
<Base title="Podcasts" description="Podcasts by Joseph Kotzker.">
  <h1>Podcasts</h1>
  {podcasts.length === 0 ? (
    <p>Coming soon.</p>
  ) : (
    podcasts.map(({ id, data }) => (
      <>
        <h2 id={id}>{data.name}</h2>
        <p class="meta">{data.role}</p>
        <p set:html={inlineMarkdown(data.description)} />
        {data.episodes && data.episodes.length > 0 && (
          <ul class="episodes labelled">
            {/* An unnumbered episode keeps an empty label so its title stays in the title column. */}
            {data.episodes.map((e) => <li><span class="label">{label(e)}</span> <a href={e.url}>{e.title}</a></li>)}
          </ul>
        )}
        <LinkRow links={data.links} />
      </>
    ))
  )}
</Base>
